#include <iostream>
using namespace std;

int main()
{
    int n, digit, count[10] = {0};

    cin >> n;

    while(n > 0)
    {
        digit = n % 10;
        count[digit]++;
        n = n / 10;
    }

    for(int i = 0; i < 10; i++)
    {
        if(count[i] > 0)
            cout << i << " = " << count[i] << endl;
    }

    return 0;
}
